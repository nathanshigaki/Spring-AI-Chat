# =====================================================================
# Configuração de Variáveis de Ambiente - Smart Budgeting API
# =====================================================================
# Instruções: Copie este arquivo para .env e preencha sua chave da Groq:
# cp .env.example .env (Linux/Mac) ou Copy-Item .env.example .env (PowerShell)
# =====================================================================

# Chave gratuita da Groq Cloud API (obtenha em https://console.groq.com/keys)
GROQ_API_KEY=gsk_sua_chave_aqui

# Configurações opcionais da IA (já possuem valores padrão otimizados)
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_CHAT_MODEL=llama-3.3-70b-versatile
# AI_AUDIO_MODEL=whisper-large-v3
